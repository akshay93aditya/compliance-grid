# Compliance Grid — environment variables
#
# Copy to `.env` and fill in real values. `.env` is gitignored.
# Per docs/specs/06-tech-stack.md: secrets via environment only, never committed.

# --- PostgreSQL (CKG, Coverage Ledger, Org Vault) ---
# Per D23, local Postgres runs via Homebrew (postgresql@17 + pgvector).
# Default brew install creates a passwordless local user matching your macOS
# username. Replace <user> with your macOS username (run `whoami` if unsure).
# Example for the local dev database:
#   postgres://<user>@localhost:5432/compliance_grid_dev
DATABASE_URL=

# --- Anthropic API (runtime agents behind typed contract wrappers) ---
# Required for: /calendar, /alerts, the patrol loop, and any extraction.
# /health and /obligations work without it (no AI cost).
ANTHROPIC_API_KEY=

# --- Org Vault master key (AES-256-GCM) ---
# Required as soon as a user signs up (the auth + onboarding flow itself
# does not touch the vault, but the engines load proof state on /health
# from a vault-protected table). Generate one with:
#   openssl rand -hex 32
# Or pass any passphrase — it'll be derived via scrypt with a fixed salt.
# Rotate by re-encrypting every ciphertext under the new key (deferred
# tooling, manual for v1).
COMPLIANCE_GRID_VAULT_KEY=

# --- Crawler contact (RFC 9110 From: header) ---
# Sent on every HTTP fetch so site administrators can trace traffic and
# reach the operator running this instance. If unset, defaults to a
# non-routable placeholder so no maintainer's personal email is ever
# silently leaked. Set this to an address you actually monitor.
COMPLIANCE_GRID_CONTACT_EMAIL=

# --- Runtime ---
NODE_ENV=development

# --- Optional: patrol (cron-driven re-fetch of known sources) ---
# PATROL_JURISDICTION=IN-KA
# PATROL_DOMAIN=labour
# PATROL_MAX_SOURCES=50
# PATROL_OLDER_THAN_DAYS=7
# PATROL_MAX_SEGMENTS_PER_SOURCE=10

# --- Optional: federation (cg publish / cg pull) ---
# COMPLIANCE_GRID_DATA_REMOTE points at where the publisher pushes:
#   - Maintainer flow: upstream (akshay93aditya/compliance-grid-data)
#   - External contributor flow: your fork
# COMPLIANCE_GRID_DATA_REMOTE=git@github.com:<owner>/compliance-grid-data.git
# COMPLIANCE_GRID_DATA_WORKSPACE=/tmp/cg-data
# PUBLISH_EXTRACTED_BY=<your-handle>
# PULL_EXTRACTED_BY=commons
# Set UPSTREAM only if you're contributing from a fork (so the PR lands
# in the canonical repo, not in your fork's own branch):
# COMPLIANCE_GRID_DATA_UPSTREAM=akshay93aditya/compliance-grid-data
